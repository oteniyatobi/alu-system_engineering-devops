#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on port 8080 on all IPs

if ! id -u nginx >/dev/null 2>&1; then
  useradd -r -s /usr/sbin/nologin nginx
fi

sed -i "s/^\s*#\?\s*user\s\+.*/user nginx;/" /etc/nginx/nginx.conf

if ! grep -q "^user nginx;" /etc/nginx/nginx.conf; then
  sed -i "1i user nginx;" /etc/nginx/nginx.conf
fi

sed -i "s/listen\s\+80\s\+default_server;/listen 8080 default_server;/" /etc/nginx/sites-available/default
sed -i "s/listen\s\+\[::\]:80\s\+default_server;/listen [::]:8080 default_server;/" /etc/nginx/sites-available/default

nginx -t

service nginx restart || {
  pkill -f "nginx: master process" 2>/dev/null
  sleep 1
  nginx
}
